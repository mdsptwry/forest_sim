species_params <- read.csv("data/species_allometry_params.csv")

# ---- Full species pool (all ~307 species, from real census data) ----------
# Wrapped in a function (not evaluated at top level) so intermediate objects
# don't linger in global memory after this runs once at startup.
build_full_species_pool <- function() {
  tryCatch({
    raw <- load_census(1)
    alive_rows <- raw[raw$status %in% c("A", "AD", "AM", "AR"), ]
    codes <- unique(alive_rows$sp)
    codes <- codes[!is.na(codes) & codes != ""]
    sort(codes)
  }, error = function(e) {
    message("Could not load census 1 to build the full species pool (", conditionMessage(e),
            "). Falling back to the 162 species in species_allometry_params.csv.")
    sort(unique(species_params$species))
  })
}
full_species_pool <- build_full_species_pool()
message(sprintf("Full species pool loaded: %d species (%d have real fitted allometry).",
                 length(full_species_pool), sum(full_species_pool %in% species_params$species)))

# ---- Real DBH distribution (for procedural generation) ---------------------
# Per-species, pooled across all 8 real censuses, deduplicated to ONE
# randomly-chosen measurement per unique real tree.
#
# Why dedup matters: a naive pool of every (census, tree) alive-status row
# lets a long-lived tree contribute one observation per census it survived —
# all from progressively LATER, LARGER points in its growth. A tree tracked
# across 6 censuses gets 6 votes, all skewed toward its bigger, older sizes;
# a tree only ever seen once gets 1. That systematically inflates the pooled
# distribution's mean above what any single real census snapshot actually
# looks like — confirmed empirically (procedural mean ~10cm vs. a single
# real census's ~5cm). Deduplicating to one random measurement per tree ID
# removes that inflation mechanism entirely, while still keeping every
# distinct real individual (so a species only recruited starting in a later
# census is still represented — genuine breadth is preserved, only the
# double-counting of the SAME individual is removed).
#
# A global pool (all species combined) is kept as the fallback for species
# with too little species-specific data to draw from reliably — a handful
# of real measurements would otherwise make every procedural tree of that
# species look nearly identical, recreating the "too uniform" problem this
# fix is meant to solve, just at the species level.
#
# Honest tradeoff: caching all 8 censuses (vs. just census 1) is a real,
# permanent memory cost for the container's whole lifetime, directly
# competing with headroom set aside for pushing toward higher tree counts.
# Worth watching Render's memory graph after this change alongside whatever
# tree-count testing is still in progress.
MIN_SPECIES_DBH_SAMPLES <- 5

build_species_dbh_pools <- function() {
  tryCatch({
    all_dbh <- lapply(1:8, function(cn) {
      raw <- load_census(cn)
      alive <- raw[raw$status %in% c("A", "AD", "AM", "AR") &
                     !is.na(raw$dbh) & !is.na(raw$sp) & raw$sp != "", ]
      data.frame(id = alive$treeID, species = alive$sp, dbh_cm = alive$dbh / 10)
    })
    combined <- do.call(rbind, all_dbh)
    combined <- combined[!is.na(combined$dbh_cm) & combined$dbh_cm > 0, ]

    # One random measurement per unique real tree: shuffle rows, then keep
    # the first occurrence of each tree id — since order is now random,
    # "first" is equivalent to "a uniformly random pick" per tree.
    combined <- combined[sample(nrow(combined)), ]
    combined <- combined[!duplicated(combined$id), ]

    split(combined$dbh_cm, combined$species)
  }, error = function(e) {
    message("Could not build per-species DBH pools (", conditionMessage(e),
            "). Falling back to log-normal sampling.")
    NULL
  })
}
species_dbh_pools <- build_species_dbh_pools()
gc()  # reclaim the temporary combined table now that it's split into pools

# Global pool, kept as the fallback for species with too little data.
real_dbh_pool <- if (!is.null(species_dbh_pools)) unlist(species_dbh_pools, use.names = FALSE) else NULL
if (!is.null(real_dbh_pool)) {
  message(sprintf("Per-species DBH pools loaded: %d species, %d total measurements pooled across 8 censuses (global range %.1f-%.1f cm).",
                   length(species_dbh_pools), length(real_dbh_pool), min(real_dbh_pool), max(real_dbh_pool)))
}

# Draws one DBH value per tree, matched to that tree's own assigned species.
sample_dbh_for_species <- function(species_vec) {
  n <- length(species_vec)
  if (is.null(species_dbh_pools) || is.null(real_dbh_pool)) {
    return(pmin(pmax(rlnorm(n, meanlog = log(5.5) - 0.9^2 / 2, sdlog = 0.9), 1), 80))
  }

  out <- numeric(n)
  for (sp in unique(species_vec)) {
    idx  <- which(species_vec == sp)
    pool <- species_dbh_pools[[sp]]
    if (is.null(pool) || length(pool) < MIN_SPECIES_DBH_SAMPLES) {
      pool <- real_dbh_pool  # not enough species-specific data — use the global pool instead
    }
    out[idx] <- sample(pool, length(idx), replace = TRUE)
  }
  out
}

# ---- helper: resolve a set of species names into a full params table ------

resolve_species_subset <- function(names) {
  global_a  <- median(species_params$a,  na.rm = TRUE)
  global_b  <- median(species_params$b,  na.rm = TRUE)
  global_ta <- median(species_params$ta, na.rm = TRUE)
  global_tb <- median(species_params$tb, na.rm = TRUE)
  global_tk <- median(species_params$tk, na.rm = TRUE)

  tibble(species = names) |>
    left_join(species_params, by = "species") |>
    mutate(
      a  = ifelse(is.na(a),  global_a,  a),
      b  = ifelse(is.na(b),  global_b,  b),
      ta = ifelse(is.na(ta), global_ta, ta),
      tb = ifelse(is.na(tb), global_tb, tb),
      tk = ifelse(is.na(tk), global_tk, tk)
    )
}

# Stratified species sample:
stratified_species_sample <- function(species_names, n_trees) {
  n_species <- length(species_names)
  if (n_species == 0) return(character(0))
  
  if (n_trees <= n_species) {
    # Not enough budget to cover every species. Sample without replacement
    # so we cover as many distinct species as the budget allows, rather
    # than letting a few species dominate purely by sampling order.
    return(sample(species_names, n_trees))
  }
  
  guaranteed <- species_names                          # exactly one of each
  filler     <- sample(species_names, n_trees - n_species, replace = TRUE)
  
  sample(c(guaranteed, filler))  # shuffle so the guaranteed slots aren't clustered at low id values
}

# ---- helper: procedural initial layout ------------------------------------
generate_layout <- function(n_trees, plot_width, plot_height,
                            n_clusters = 15, cluster_fraction = 0.25) {
  x <- runif(n_trees, 0, plot_width)
  y <- runif(n_trees, 0, plot_height)
  
  n_clustered <- round(n_trees * cluster_fraction)
  if (n_clustered > 0) {
    hotspots <- tibble(
      cx = runif(n_clusters, 0, plot_width),
      cy = runif(n_clusters, 0, plot_height)
    )
    clustered_idx    <- sample(seq_len(n_trees), n_clustered)
    assigned_cluster <- sample(seq_len(n_clusters), n_clustered, replace = TRUE)
    x[clustered_idx] <- hotspots$cx[assigned_cluster] + rnorm(n_clustered, 0, plot_width  * 0.02)
    y[clustered_idx] <- hotspots$cy[assigned_cluster] + rnorm(n_clustered, 0, plot_height * 0.02)
  }
  
  tibble(
    x = pmin(pmax(x, 0), plot_width),
    y = pmin(pmax(y, 0), plot_height)
  )
}



