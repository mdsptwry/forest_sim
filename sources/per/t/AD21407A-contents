# ---- helper: load a real BCI census file (cached, trimmed) --------------
# Caches each census in memory after its first load, so repeated requests
# don't re-read and re-parse the same ~423k-row file from disk every single
# time — this was happening on EVERY /init_from_census call before,
# regardless of how many trees were actually requested. Also trims to only
# the 6 columns this app actually uses — the raw file has 16 (tag, quadrat,
# stemID, hom, ExactDate, codes, date, nostems, agb, ba, ...) that were
# getting carried through every downstream filter/mutate for no benefit.
# Bounded worst case: at most 8 census files ever cached (one per real
# census), each much smaller post-trim than the full raw table.
.census_cache <- new.env(parent = emptyenv())

load_census <- function(census_number) {
  cache_key <- as.character(census_number)
  if (!is.null(.census_cache[[cache_key]])) {
    return(.census_cache[[cache_key]])
  }

  path <- sprintf("data/bci.tree%d.rdata", census_number)
  if (!file.exists(path)) {
    stop(sprintf("Census file not found: %s", path))
  }
  e <- new.env()
  load(path, envir = e)
  obj_name <- sprintf("bci.tree%d", census_number)
  if (!exists(obj_name, envir = e)) {
    loaded_names <- ls(e)
    if (length(loaded_names) == 1) {
      obj_name <- loaded_names[1]
    } else {
      stop(sprintf(
        "Could not find object '%s' in %s. Objects found instead: %s",
        obj_name, path, paste(loaded_names, collapse = ", ")
      ))
    }
  }
  raw <- get(obj_name, envir = e)
  raw <- raw[, c("treeID", "sp", "gx", "gy", "dbh", "status")]

  .census_cache[[cache_key]] <- raw
  raw
}

